@startuml ZenithWeb_Secuencia_AgregarProducto_Alternativo
' Diagrama de secuencia alternativo: Agregar Producto (flujos de excepcion)
' Cubre: datos invalidos (validarProducto) y nombre duplicado (getPorNombre)
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Usuario
participant "Sistema\n(Interfaz)" as Sistema
participant Producto
participant Categoria

Usuario -> Sistema : selecciona "nuevo producto"
Sistema -> Categoria : obtenerCategorias()
Categoria --> Sistema : listado de categorias
Sistema --> Usuario : muestra formulario

Usuario -> Sistema : completa los campos
Usuario -> Sistema : guarda cambios

Sistema -> Producto : crearProducto(datos)

alt datos invalidos (nombre vacio, stock o precios < 0, sin categoria)
    Producto -> Producto : validarProducto(datos) lanza Error
    Producto --> Sistema : Error "datos no validos" (400)
    Sistema --> Usuario : muestra error, vuelve al formulario
else ya existe un producto con ese nombre
    Producto -> Producto : getPorNombre(nombre) devuelve existente
    Producto --> Sistema : Error "Ya existe un producto con ese nombre"
    Sistema --> Usuario : muestra error, vuelve al formulario
else datos validos y nombre disponible
    Producto -> Producto : getPorNombre(nombre) = null
    Producto --> Sistema : producto creado
    Sistema --> Usuario : producto agregado
end

@enduml
