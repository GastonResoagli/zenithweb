@startuml ZenithWeb_Secuencia_ModificarProducto_Alternativo
' Diagrama de secuencia alternativo: Modificar Producto (flujos de excepcion)
' Cubre: producto inexistente y nombre que pertenece a OTRO producto
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Usuario
participant "Sistema\n(Interfaz)" as Sistema
participant Producto
participant Categoria

Usuario -> Sistema : selecciona "editar producto"
Sistema -> Producto : getById(id)

alt producto no encontrado
    Producto --> Sistema : null
    Sistema --> Usuario : muestra error "producto no encontrado"
else producto encontrado
    Producto --> Sistema : datos del producto
    Sistema -> Categoria : obtenerCategorias()
    Categoria --> Sistema : listado de categorias
    Sistema --> Usuario : muestra formulario con datos cargados

    Usuario -> Sistema : modifica los campos
    Usuario -> Sistema : guarda cambios
    Sistema -> Producto : update(id, datos)
    Producto -> Producto : getPorNombre(nombre)

    alt el nombre pertenece a OTRO producto (existente.id != id)
        Producto --> Sistema : Error "Ya existe un producto con ese nombre"
        Sistema --> Usuario : muestra error, vuelve al formulario
    else nombre libre o es el del propio producto
        Producto -> Producto : update() (actualiza el registro)
        Producto --> Sistema : producto actualizado
        Sistema --> Usuario : producto modificado
    end
end

@enduml
