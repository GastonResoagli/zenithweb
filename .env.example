# ============================================================================
# Variables de entorno del BACKEND (Express) — ZenithWeb
# ----------------------------------------------------------------------------
# Copiar a ".env" para desarrollo local. En Render se cargan desde el panel
# "Environment" del servicio (NO se sube el .env real al repo).
# ============================================================================

# --- PRODUCCIÓN (Render + Supabase) ---
# Connection string del POOLER de Supabase (Project Settings > Database > Connection Pooling).
# Formato: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# Si DATABASE_URL está definida, el backend la usa con SSL y se IGNORAN las DB_* de abajo.
# DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Dominio del frontend en Vercel (restringe el CORS). Ej: https://zenithweb.vercel.app
# FRONTEND_URL=https://zenithweb.vercel.app

# Secreto para firmar los JWT (poné un valor largo y aleatorio en producción).
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Puerto. Render inyecta su propio PORT automáticamente; en local usa 3000.
PORT=3000

# --- DESARROLLO LOCAL (PostgreSQL en tu máquina) ---
# Se usan solo si DATABASE_URL NO está definida.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=control_stock
DB_PASSWORD=5252
DB_PORT=5432
