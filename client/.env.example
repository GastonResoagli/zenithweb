# ============================================================================
# Variables de entorno del FRONTEND (Vite/React) — ZenithWeb
# ----------------------------------------------------------------------------
# Copiar a "client/.env" para desarrollo local.
# En Vercel se configura en Settings > Environment Variables.
# Las variables expuestas al navegador DEBEN empezar con VITE_.
# ============================================================================

# URL pública del backend en Render. Ej: https://zenithweb-api.onrender.com
# (sin barra final). Si no se define, el front usa http://localhost:3000.
VITE_API_URL=https://zenithweb-api.onrender.com
